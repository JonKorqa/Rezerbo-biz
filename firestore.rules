rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /salons/{salonId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.address is string
        && request.resource.data.phone is string
        && request.resource.data.photos is list;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /services/{serviceId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.salonId is string
        && request.resource.data.name is string
        && request.resource.data.price is number
        && request.resource.data.durationMinutes is int
        && exists(/databases/$(database)/documents/salons/$(request.resource.data.salonId))
        && get(/databases/$(database)/documents/salons/$(request.resource.data.salonId)).data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && get(/databases/$(database)/documents/salons/$(resource.data.salonId)).data.ownerId == request.auth.uid;
    }

    match /feedback/{feedbackId} {
      allow create: if request.auth != null
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1
        && request.resource.data.rating <= 5
        && request.resource.data.comment is string;
      allow read, update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if request.auth != null
        && resource.data.customerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.paymentMethod in ['cash', 'card']
        && request.resource.data.salonId is string
        && request.resource.data.serviceId is string
        && request.resource.data.staffId is string
        && request.resource.data.datetime is timestamp
        && request.resource.data.notes is string;
      allow update: if request.auth != null
        && resource.data.customerId == request.auth.uid
        && request.resource.data.status == 'cancelled'
        && request.resource.data.paymentMethod in ['cash', 'card'];
      allow delete: if false;
    }

    // Rezervo Biz: one document per business, keyed by the owning user's uid.
    match /businesses/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Public-safe subset synced by Rezervo Biz alongside every businesses/{uid} save
    // that touches a public field. The parent businesses/{uid} document is owner-only;
    // this document contains ONLY explicitly whitelisted public fields.
    // Open read (unauthenticated clients may read); only the owning business may write.
    match /businessProfiles/{uid} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Rezervo Biz: top-level, scoped by businessId field set on the document.
    match /appointments/{appointmentId} {
      allow read, update, delete: if request.auth != null
        && resource.data.businessId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.businessId == request.auth.uid;
    }

    // Rezervo Biz: top-level, scoped by businessId field set on the document.
    match /transactions/{transactionId} {
      allow read, update, delete: if request.auth != null
        && resource.data.businessId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.businessId == request.auth.uid;
    }

    // Rezervo Biz: clients are a SUBCOLLECTION under businesses/{businessId}/clients
    // (see src/services/clients.ts), not a top-level collection — scoped by the
    // path segment, with the businessId field on the doc cross-checked on writes.
    match /businesses/{businessId}/clients/{clientId} {
      allow read: if request.auth != null && request.auth.uid == businessId;
      allow create: if request.auth != null && request.auth.uid == businessId
        && request.resource.data.businessId == businessId;
      allow update, delete: if request.auth != null && request.auth.uid == businessId
        && resource.data.businessId == businessId;
    }

    // Rezervo Biz: services are a SUBCOLLECTION under businesses/{businessId}/services
    // (see src/services/services.ts), not a top-level collection — scoped by the
    // path segment, with the businessId field on the doc cross-checked on writes.
    match /businesses/{businessId}/services/{serviceId} {
      allow read: if request.auth != null && request.auth.uid == businessId;
      allow create: if request.auth != null && request.auth.uid == businessId
        && request.resource.data.businessId == businessId;
      allow update, delete: if request.auth != null && request.auth.uid == businessId
        && resource.data.businessId == businessId;
    }

    // Rezervo Biz: notifications are a SUBCOLLECTION under businesses/{businessId}/notifications
    // (see src/services/notifications.ts), not a top-level collection — scoped by the
    // path segment, with the businessId field on the doc cross-checked on writes.
    // NOT YET DEPLOYED — added alongside the in-app notifications feature, batch with
    // any other pending rules before running `firebase deploy --only firestore:rules`.
    match /businesses/{businessId}/notifications/{notificationId} {
      allow read: if request.auth != null && request.auth.uid == businessId;
      allow create: if request.auth != null && request.auth.uid == businessId
        && request.resource.data.businessId == businessId;
      allow update, delete: if request.auth != null && request.auth.uid == businessId
        && resource.data.businessId == businessId;
    }

    // Rezervo Biz: staff are a SUBCOLLECTION under businesses/{businessId}/staff
    // (see src/services/staff.ts), not a top-level collection — scoped by the
    // path segment, with the businessId field on the doc cross-checked on writes.
    // NOT YET DEPLOYED — added alongside Staff Management, batch with any other
    // pending rules before running `firebase deploy --only firestore:rules`.
    match /businesses/{businessId}/staff/{staffId} {
      allow read: if request.auth != null && request.auth.uid == businessId;
      allow create: if request.auth != null && request.auth.uid == businessId
        && request.resource.data.businessId == businessId;
      allow update, delete: if request.auth != null && request.auth.uid == businessId
        && resource.data.businessId == businessId;
    }

    // Rezervo Biz: memberships are a SUBCOLLECTION under businesses/{businessId}/memberships
    // (see src/services/memberships.ts), not a top-level collection — scoped by the
    // path segment, with the businessId field on the doc cross-checked on writes.
    // NOT YET DEPLOYED — added alongside the Memberships feature, batch with any other
    // pending rules before running `firebase deploy --only firestore:rules`.
    match /businesses/{businessId}/memberships/{membershipId} {
      allow read: if request.auth != null && request.auth.uid == businessId;
      allow create: if request.auth != null && request.auth.uid == businessId
        && request.resource.data.businessId == businessId;
      allow update, delete: if request.auth != null && request.auth.uid == businessId
        && resource.data.businessId == businessId;
    }

    // Rezervo Biz: packages are a SUBCOLLECTION under businesses/{businessId}/packages
    // (see src/services/packages.ts), not a top-level collection — scoped by the
    // path segment, with the businessId field on the doc cross-checked on writes.
    // NOT YET DEPLOYED — added alongside the Packages feature, batch with any other
    // pending rules before running `firebase deploy --only firestore:rules`.
    match /businesses/{businessId}/packages/{packageId} {
      allow read: if request.auth != null && request.auth.uid == businessId;
      allow create: if request.auth != null && request.auth.uid == businessId
        && request.resource.data.businessId == businessId;
      allow update, delete: if request.auth != null && request.auth.uid == businessId
        && resource.data.businessId == businessId;
    }

    // Rezervo Biz: no client-side code writes to `reviews` yet (grepped the repo,
    // no matches) — this rule is speculative/future-proofing per request, using the
    // businessId-field pattern. Re-verify field names once review submission is built.
    match /reviews/{reviewId} {
      allow read: if true;
      allow write: if request.auth != null &&
        (resource == null ? request.resource.data.businessId : resource.data.businessId) == request.auth.uid;
    }
  }
}
