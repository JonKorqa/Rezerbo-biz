{
  "expo": {
    "name": "rezervo-biz",
    "slug": "rezervo-biz",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.rezervobiz"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "react-native-maps",
        {
          "androidGoogleMapsApiKey": "AIzaSyA-IaW7Zm4HvVm1VmJaamq8QdmWtTTd5_w"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Allow Rezervo Biz to use your location to set your business address."
        }
      ]
    ]
  }
}
